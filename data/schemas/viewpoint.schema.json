{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gamehack/zhuozhengyuan/blob/main/data/schemas/viewpoint.schema.json",
  "title": "Zhuozhengyuan Reference Viewpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["viewpoint_id", "area", "camera_position_local_m", "look_at_local_m", "source_ids", "capture_date", "status"],
  "properties": {
    "viewpoint_id": {"type": "string", "pattern": "^ZJY-VIEW-[0-9]{3,}$"},
    "area": {"enum": ["east", "central", "west", "residential"]},
    "camera_position_local_m": {"$ref": "#/$defs/vector3"},
    "look_at_local_m": {"$ref": "#/$defs/vector3"},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^REF-[0-9]{3,}$"}},
    "capture_date": {"type": "string", "format": "date"},
    "photo_path": {"type": ["string", "null"]},
    "focal_length_mm": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "status": {"enum": ["planned", "captured", "calibrated", "approved"]},
    "notes": {"type": "string"}
  },
  "$defs": {
    "vector3": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 3,
      "maxItems": 3
    }
  }
}
